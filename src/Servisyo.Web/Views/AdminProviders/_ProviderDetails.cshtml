@using Servisyo.Web.ViewModels
@model ProviderDetailsViewModel
@{
    // Where "Close" goes when JavaScript is not opening this as a pop-up.
    var closeUrl = Url.Action("Index", "AdminProviders", new { status = Model.ReturnStatus == ProviderStatuses.All ? null : Model.ReturnStatus, page = Model.ReturnPage });
}
<div class="sv-rv sv-pd" data-sv-review>
    <div class="sv-rv__head">
        <div>
            <h2 class="sv-rv__title" id="sv-rv-title">Provider Details</h2>
            <p class="sv-rv__id">Manage account status and view the complete business profile</p>
        </div>
        <a class="sv-rv__x" href="@closeUrl" data-sv-close aria-label="Close">&times;</a>
    </div>

    <div class="sv-pd__banner">
        <span class="sv-avatar sv-avatar--lg" aria-hidden="true">@Model.Initials</span>
        <div class="sv-pd__who">
            <div class="sv-pd__name">@Model.Name</div>
            <div class="sv-pd__biz">@Model.BusinessName</div>
            @if (Model.Location is not null)
            {
                <div class="sv-pd__where">@Model.Location</div>
            }
        </div>
        <div class="sv-pd__badges">
            @foreach (var b in Model.Badges)
            {
                <span class="sv-tag sv-tag--@b.Tone">@b.Text</span>
            }
        </div>
    </div>

    <dl class="sv-pd__grid">
        <div class="sv-pd__cell">
            <dt>Email Address</dt>
            <dd>@Model.Email</dd>
        </div>
        <div class="sv-pd__cell">
            <dt>Phone Number</dt>
            <dd>@if (Model.Phone is null) { <span class="sv-rv__none">Not provided</span> } else { @Model.Phone }</dd>
        </div>
        <div class="sv-pd__cell">
            <dt>Member Since</dt>
            <dd>@Model.MemberSince</dd>
        </div>
        <div class="sv-pd__cell">
            <dt>Completed Jobs</dt>
            <dd>@Model.CompletedJobs</dd>
        </div>
        <div class="sv-pd__cell">
            <dt>Rating</dt>
            <dd>@Model.RatingText</dd>
        </div>
        <div class="sv-pd__cell">
            <dt>Address</dt>
            <dd>@if (Model.Address is null) { <span class="sv-rv__none">Not provided</span> } else { @Model.Address }</dd>
        </div>
    </dl>

    <div class="sv-pd__section">
        <h3 class="sv-pd__h">About / Business Summary</h3>
        @if (Model.Description is null)
        {
            <p class="sv-pd__box sv-rv__none">No description yet.</p>
        }
        else
        {
            <p class="sv-pd__box">@Model.Description</p>
        }
    </div>

    <div class="sv-pd__section">
        <h3 class="sv-pd__h">Services &amp; Base Fees</h3>
        @if (Model.Services.Count == 0)
        {
            <p class="sv-rv__none sv-pd__none">No active services listed.</p>
        }
        else
        {
            <ul class="sv-pd__services">
                @foreach (var s in Model.Services)
                {
                    <li>
                        <span class="sv-pd__sname">@s.Name <span class="sv-pd__scat">@s.Category</span></span>
                        <span class="sv-pd__sprice">@s.PriceText <span>· @s.DurationText</span></span>
                    </li>
                }
            </ul>
        }
    </div>

    <div class="sv-pd__section">
        @* Database v2.7: fetched again by admin-approval.js when this provider's days off change (pushed by SignalR) *@
        <div data-sv-dayoff-live="true" data-provider-id="@Model.ProviderId"
             data-refresh-url="@Url.Action("Details", "AdminProviders", new { providerId = Model.ProviderId, status = Model.ReturnStatus == ProviderStatuses.All ? null : Model.ReturnStatus, page = Model.ReturnPage, partial = true })">
            <h3 class="sv-pd__h">Days Off (until Dec 31)
                @if (Model.PendingRequests > 0)
                {
                    <span class="sv-tag sv-tag--pending">@Model.PendingRequests waiting for you</span>
                }
            </h3>
            @if (Model.DaysOff.Count == 0)
            {
                <p class="sv-rv__none sv-pd__none">No days off planned.</p>
            }
            else
            {
                <ul class="sv-pd__daysoff">
                    @foreach (var d in Model.DaysOff)
                    {
                        <li class="@(d.IsPending ? "is-pending" : "")">
                            <span class="sv-pd__dodate">@d.DateText <span class="sv-pd__dodays">· @d.DaysText</span></span>
                            <span class="sv-pd__doreason">@(d.Reason ?? "No reason given")</span>
                            <span class="sv-tag sv-tag--@d.Tone">@d.Label</span>
                            @if (d.IsPending && d.RequestId is not null)
                            {
                                @* approving blocks bookings on these days; rejecting gives the dates back (saved with an admin log entry) *@
                                <form asp-controller="AdminProviders" asp-action="DecideDayOff" asp-route-providerId="@Model.ProviderId" asp-route-requestId="@d.RequestId"
                                      method="post" class="sv-pd__dodecide" data-sv-decision-form>
                                    <input type="hidden" name="ReturnStatus" value="@Model.ReturnStatus" />
                                    <input type="hidden" name="ReturnPage" value="@Model.ReturnPage" />
                                    <button type="submit" name="Decision" value="Approve" class="sv-btn sv-btn--xs sv-btn--primary"
                                            data-confirm="Approve @(Model.Name)'s day off for @(d.DateText)? Customers will not be able to book them on those days.">Approve</button>
                                    <button type="submit" name="Decision" value="Reject" class="sv-btn sv-btn--xs sv-btn--danger-outline"
                                            data-confirm="Reject @(Model.Name)'s day off request for @(d.DateText)? They stay available on those days.">Reject</button>
                                </form>
                            }
                        </li>
                    }
                </ul>
            }
        </div>

        @if (Model.CanApproveDayOff)
        {
            @* an emergency (even today, which a provider cannot request); saved with an admin log entry (ADMIN_ACTIONS) *@
            <form asp-controller="AdminProviders" asp-action="ApproveExtraDayOff" asp-route-providerId="@Model.ProviderId"
                  method="post" class="sv-pd__dayoff" data-sv-decision-form>
                <input type="hidden" name="ReturnStatus" value="@Model.ReturnStatus" />
                <input type="hidden" name="ReturnPage" value="@Model.ReturnPage" />
                <p class="sv-pd__dohint">Emergency (for example sick today): give the provider a day off right away, without a request. Days with an active booking cannot be given.</p>
                <div class="sv-pd__dorow">
                    <label class="sv-sr-only" for="sv-pd-dodate">Day off</label>
                    <input id="sv-pd-dodate" name="Date" type="date" required min="@Model.DayOffMin" max="@Model.DayOffMax" />
                    <label class="sv-sr-only" for="sv-pd-doreason">Reason</label>
                    <input id="sv-pd-doreason" name="Reason" type="text" required maxlength="@Servisyo.Web.Services.ProviderManagementService.MaxExtraDayReasonLength"
                           placeholder="Reason (provider sees it)" />
                    <button type="submit" class="sv-btn sv-btn--sm sv-btn--primary">Give extra day off</button>
                </div>
            </form>
        }
    </div>

    <form asp-controller="AdminProviders" asp-action="ChangeStatus" asp-route-providerId="@Model.ProviderId"
          method="post" class="sv-rv__form sv-pd__form" data-sv-decision-form>
        <input type="hidden" name="ReturnStatus" value="@Model.ReturnStatus" />
        <input type="hidden" name="ReturnPage" value="@Model.ReturnPage" />

        @if (Model.AsksReason)
        {
            <div class="sv-rv__note">
                <label for="sv-pd-reason">Reason <span>(optional)</span></label>
                <textarea id="sv-pd-reason" name="Reason" rows="2" maxlength="255"
                          placeholder="Saved in the admin activity log. The provider does not see it."></textarea>
            </div>
        }

        <div class="sv-rv__foot">
            <a class="sv-btn sv-btn--sm sv-btn--outline" href="@closeUrl" data-sv-close>Close</a>
            @foreach (var a in Model.Actions)
            {
                var confirmText = $"{a.Label} {Model.Name}? {a.Text}";
                var cssTone = a.Tone == "warn" ? "sv-btn--warn-outline" : a.Tone == "danger" ? "sv-btn--danger-outline" : "sv-btn--primary";
                var noun = (a.Action == "Suspend" || a.Action == "Deactivate") ? "Provider" : "Account";
                <button type="submit" name="Action" value="@a.Action" class="sv-btn sv-btn--sm @cssTone"
                        data-confirm="@confirmText">@a.Label @noun</button>
            }
        </div>
    </form>
</div>
