@using Servisyo.Web.Helpers
@using Servisyo.Web.ViewModels
@model UsersPageViewModel
@{
    ViewData["Title"] = "Users";
    Layout = "_PortalLayout";
    ViewData["Shell"] = Model.Shell;
    ViewData["ActiveNav"] = "users";

    var soon = "Available in an upcoming update";

    var tabs = new (string Key, string Label, int Count)[]
    {
        ("All", "All", Model.CountAll),
        ("Active", "Active", Model.CountActive),
        ("Suspended", "Suspended", Model.CountSuspended),
        ("Deactivated", "Deactivated", Model.CountDeactivated)
    };

    string? Q() => string.IsNullOrEmpty(Model.Q) ? null : Model.Q;
    string? StatusParam() => Model.Status == "All" ? null : Model.Status;
}

<p class="sv-eyebrow">Accounts</p>
<h1 class="sv-dash__title">Users</h1>
<p class="sv-dash__sub">View and manage all registered customer accounts.</p>

@if (!string.IsNullOrEmpty(Model.FlashMessage))
{
    <div class="sv-flash @(Model.FlashIsError ? "sv-flash--error" : "sv-flash--ok")" role="status">@Model.FlashMessage</div>
}

<div class="sv-toolbar">
    <form method="get" asp-controller="AdminUsers" asp-action="Index" class="sv-search" role="search">
        <span class="sv-search__icon">@Icons.Svg("search", 16)</span>
        <input type="search" name="q" value="@Model.Q" maxlength="100" placeholder="Search by name or email..." aria-label="Search by name or email" />
        @if (StatusParam() is not null)
        {
            <input type="hidden" name="status" value="@Model.Status" />
        }
    </form>

    <nav class="sv-tabs" aria-label="Filter by account status">
        @foreach (var t in tabs)
        {
            <a class="sv-tab @(t.Key == Model.Status ? "is-active" : "")"
               href="@Url.Action("Index", "AdminUsers", new { status = t.Key == "All" ? null : t.Key, q = Q() })"
               aria-current="@(t.Key == Model.Status ? "page" : null)">
                @t.Label <span class="sv-tab__n">(@t.Count)</span>
            </a>
        }
    </nav>
</div>

<div class="sv-table-wrap">
    <table class="sv-table">
        <thead>
            <tr>
                <th scope="col">Name</th>
                <th scope="col">Email</th>
                <th scope="col">City</th>
                <th scope="col">Status</th>
                <th scope="col" class="sv-table__right">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Rows.Count == 0)
            {
                <tr>
                    <td colspan="5" class="sv-table__empty">
                        @(Model.CountAll == 0
                            ? "No customers have registered yet."
                            : "No users match your search or filter.")
                    </td>
                </tr>
            }
            @foreach (var u in Model.Rows)
            {
                <tr>
                    <td>
                        <div class="sv-table__name">
                            <span class="sv-avatar sv-avatar--soft" aria-hidden="true">@u.Initials</span>
                            <span>@u.Name</span>
                        </div>
                    </td>
                    <td class="sv-table__muted">@u.Email</td>
                    <td class="sv-table__muted sv-table__small">@(u.City ?? "—")</td>
                    <td><span class="sv-tag sv-tag--@u.StatusTone">@u.Status</span></td>
                    <td class="sv-table__right">
                        <div class="sv-table__acts">
                            <button type="button" class="sv-act sv-act--view" disabled title="@soon">View</button>
                            @foreach (var a in u.Actions)
                            {
                                <button type="button" class="sv-act sv-act--@a.Tone"
                                        data-sv-action="@a.Action"
                                        data-user-id="@u.UserId"
                                        data-user-name="@u.Name"
                                        data-title="@a.Title"
                                        data-text="@a.Text"
                                        data-label="@a.Label"
                                        data-tone="@a.Tone"
                                        data-asks-reason="@(a.AsksReason ? "true" : "false")">@a.Label</button>
                            }
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="sv-table__foot">
    <span>Showing @Model.Rows.Count of @Model.TotalMatching @(Model.TotalMatching == 1 ? "user" : "users")</span>
    @if (Model.PageCount > 1)
    {
        <nav class="sv-pager" aria-label="Pages">
            @if (Model.Page > 1)
            {
                <a class="sv-btn sv-btn--outline sv-btn--xs" href="@Url.Action("Index", "AdminUsers", new { status = StatusParam(), q = Q(), page = Model.Page - 1 })">Previous</a>
            }
            <span>Page @Model.Page of @Model.PageCount</span>
            @if (Model.Page < Model.PageCount)
            {
                <a class="sv-btn sv-btn--outline sv-btn--xs" href="@Url.Action("Index", "AdminUsers", new { status = StatusParam(), q = Q(), page = Model.Page + 1 })">Next</a>
            }
        </nav>
    }
</div>

<!-- One shared confirmation dialog; admin-users.js fills it in for the button that was clicked. -->
<dialog id="sv-confirm" class="sv-dialog" aria-labelledby="sv-confirm-title">
    <form method="post" asp-controller="AdminUsers" asp-action="ChangeStatus" class="sv-dialog__form">
        <h2 id="sv-confirm-title" class="sv-dialog__title"></h2>
        <p class="sv-dialog__who"></p>
        <p class="sv-dialog__text"></p>

        <input type="hidden" name="UserId" />
        <input type="hidden" name="Action" />
        <input type="hidden" name="Q" value="@Model.Q" />
        <input type="hidden" name="Status" value="@Model.Status" />
        <input type="hidden" name="Page" value="@Model.Page" />

        <div class="sv-dialog__reason" hidden>
            <label for="sv-reason">Reason <span>(optional)</span></label>
            <textarea id="sv-reason" name="Reason" rows="3" maxlength="255" placeholder="Why is this being done?"></textarea>
            <p>Saved in the administrator activity log.</p>
        </div>

        <div class="sv-dialog__buttons">
            <button type="button" class="sv-btn sv-btn--outline sv-btn--sm" data-sv-close>Cancel</button>
            <button type="submit" class="sv-btn sv-btn--primary sv-btn--sm" id="sv-confirm-ok">Confirm</button>
        </div>
    </form>
</dialog>

@section Scripts {
    <script src="~/js/admin-users.js" asp-append-version="true"></script>
}
