@using System.Globalization
@using Servisyo.Web.Helpers
@using Servisyo.Web.ViewModels
@model ProviderProfilePageViewModel
@{
    ViewData["Title"] = "My Profile";
    Layout = "_PortalLayout";
    ViewData["Shell"] = Model.Shell;
    ViewData["ActiveNav"] = "profile";

    var inv = CultureInfo.InvariantCulture;
    var form = Model.Form;

    // the problem text for each box (null = no problem)
    var emailError = Model.ErrorFor("Email");
    var bioError = Model.ErrorFor("Description");

    // once an administrator approves the provider, these boxes are read-only (ProviderLockRules)
    var locked = Model.InfoLocked;
    string? lockClass = locked ? "is-locked" : null;
    string? lockTitle = locked ? ProviderLockRules.ApprovedNotice : null;
    string? lockId = locked ? "pf-locknote" : null;
    var feeText = form.BaseFee is decimal fee ? "₱" + fee.ToString("N2", inv) : "";
}

<div class="sv-pf">
    <p class="sv-eyebrow">My Profile</p>
    <h1 class="sv-dash__title">Provider Profile</h1>
    <p class="sv-dash__sub">Manage your public profile and business information.</p>

    @if (!string.IsNullOrEmpty(Model.FlashMessage))
    {
        <div class="sv-flash @(Model.FlashIsError ? "sv-flash--error" : "sv-flash--ok")" role="status">@Model.FlashMessage</div>
    }

    <!-- Profile header + strength -->
    <section class="sv-panel sv-pf__head" aria-label="Profile summary">
        <div class="sv-photo">
            <partial name="_ProfilePhoto" model="@(new ProfilePhotoViewModel(Model.Initials, Model.PhotoUrl, "sv-avatar--ink sv-pf__avatar"))" />
        </div>
        <div class="sv-pf__who">
            @* updated live when an administrator approves a name change (provider-profile.js) *@
            <div class="sv-pf__name" id="pf-head-name" data-sv-namechange-live="true">@Model.FullName</div>
            <div class="sv-pf__biz">@Model.HeaderLine</div>
            <div class="sv-pf__strength">
                <div class="sv-pf__strengthrow">
                    <span id="pf-strength-label">Profile Strength</span>
                    <strong>@Model.StrengthPercent%</strong>
                </div>
                <div class="sv-meter" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@Model.StrengthPercent" aria-labelledby="pf-strength-label">
                    <span style="width:@(Model.StrengthPercent)%"></span>
                </div>
                <p class="sv-pf__hint">@Model.StrengthHint</p>
            </div>
        </div>
    </section>

    <!-- Business information -->
    <section class="sv-panel sv-pf__card" aria-labelledby="pf-info-title">
        <h2 id="pf-info-title" class="sv-pf__title">Business Information</h2>

        <form method="post" asp-controller="ProviderProfile" asp-action="Save" class="sv-pf__form" data-sv-once>
            @if (!string.IsNullOrEmpty(Model.FormError))
            {
                <p class="sv-formerr" role="alert">@Model.FormError</p>
            }

            @if (locked)
            {
                <p class="sv-lockhint sv-lockhint--approved" id="pf-locknote" role="note">@Icons.Svg("lock", 12)
                    <span>@ProviderLockRules.ApprovedNotice
                        @if (Model.NameChange is not null)
                        {
                            <a href="#pf-namechange" class="sv-lockhint__link">Need a different name? Request a name change.</a>
                        }
                    </span>
                </p>
            }

            @* Locked boxes are disabled + read-only: the browser never sends them, and the server refuses any change (403).
               The three names are redrawn live when an administrator approves a name change (database v2.8). *@
            <div class="sv-pf__names" id="pf-names" data-sv-namechange-live="true">
            <div class="sv-fld">
                <label for="pf-first">First Name</label>
                <input id="pf-first" name="FirstName" type="text" value="@form.FirstName" maxlength="100" autocomplete="given-name"
                       class="@lockClass" disabled="@locked" readonly="@locked" title="@lockTitle" aria-describedby="@lockId" />
            </div>

            <div class="sv-fld">
                <label for="pf-middle">Middle Name</label>
                <input id="pf-middle" name="MiddleName" type="text" value="@form.MiddleName" maxlength="100" autocomplete="additional-name"
                       class="@lockClass" disabled="@locked" readonly="@locked" title="@lockTitle" aria-describedby="@lockId" />
            </div>

            <div class="sv-fld">
                <label for="pf-last">Last Name</label>
                <input id="pf-last" name="LastName" type="text" value="@form.LastName" maxlength="100" autocomplete="family-name"
                       class="@lockClass" disabled="@locked" readonly="@locked" title="@lockTitle" aria-describedby="@lockId" />
            </div>
            </div>

            <div class="sv-fld">
                <label for="pf-business">Business Name</label>
                <input id="pf-business" name="BusinessName" type="text" value="@form.BusinessName" maxlength="155" autocomplete="organization"
                       class="@lockClass" disabled="@locked" readonly="@locked" title="@lockTitle" aria-describedby="@lockId" />
            </div>

            <div class="sv-fld">
                <label for="pf-phone">Phone Number</label>
                <input id="pf-phone" name="PhoneNumber" type="tel" value="@form.PhoneNumber" maxlength="13" autocomplete="tel"
                       class="@lockClass" disabled="@locked" readonly="@locked" title="@lockTitle" aria-describedby="@lockId" />
            </div>

            <div class="sv-fld">
                <label for="pf-email">Email Address</label>
                <input id="pf-email" name="Email" type="email" value="@form.Email" required maxlength="256" autocomplete="email"
                       aria-invalid="@(emailError is null ? null : "true")" />
                @if (emailError is not null) { <p class="sv-fld__err" role="alert">@emailError</p> }
            </div>

            <div class="sv-fld">
                <label for="pf-basefee">Base Fee in PHP</label>
                @* shown as text ("₱500.00"); it is never posted (no name) because a base fee cannot be changed here *@
                <input id="pf-basefee" type="text" value="@feeText"
                       class="@lockClass" disabled="@locked" readonly="@locked" title="@lockTitle" aria-describedby="@lockId" />
            </div>

            <div class="sv-fld">
                <label for="pf-address">Address</label>
                <input id="pf-address" name="Address" type="text" value="@form.Address" maxlength="255" autocomplete="street-address"
                       class="@lockClass" disabled="@locked" readonly="@locked" title="@lockTitle" aria-describedby="@lockId" />
            </div>

            <div class="sv-fld">
                <label for="pf-bio">About / Bio <span class="sv-fld__opt">(up to 255 characters)</span></label>
                <textarea id="pf-bio" name="Description" rows="3" maxlength="255"
                          aria-invalid="@(bioError is null ? null : "true")">@form.Description</textarea>
                @if (bioError is not null) { <p class="sv-fld__err" role="alert">@bioError</p> }
            </div>

            <button type="submit" class="sv-btn sv-btn--primary sv-btn--block sv-btn--sm">Save Changes</button>
        </form>
    </section>

    @if (Model.NameChange is { } nc)
    {
        var ncForm = nc.Form;
        var firstErr = nc.ErrorFor("FirstName");
        var middleErr = nc.ErrorFor("MiddleName");
        var lastErr = nc.ErrorFor("LastName");
        var reasonErr = nc.ErrorFor("Reason");

        @* Name on your account (database v2.8): approved providers ask an administrator to change it.
           Redrawn live when the request is answered (provider-profile.js, SignalR "nameChangeChanged"). *@
        <section class="sv-panel sv-pf__card sv-ncard" id="pf-namechange" aria-labelledby="pf-nc-title"
                 data-sv-namechange-live="true" data-refresh-url="@Url.Action("Index", "ProviderProfile")">
            <h2 id="pf-nc-title" class="sv-pf__title">Name on Your Account</h2>
            <p class="sv-ncard__now">@nc.CurrentName</p>
            <p class="sv-ncard__hint">Your name is locked because your account is approved. To change it (for example after
                marriage, or to fix a spelling mistake), send a request. An administrator reviews it, and your name stays the
                same until it is approved.</p>

            @if (nc.Pending is { } waiting)
            {
                <div class="sv-ncard__req is-pending">
                    <div class="sv-ncard__line">
                        <span>Requested: <strong>@waiting.NewName</strong></span>
                        <span class="sv-tag sv-tag--@waiting.Tone">@waiting.Label</span>
                    </div>
                    <p class="sv-ncard__meta">@waiting.WhenText · Reason: @waiting.Reason</p>
                    <form method="post" asp-controller="ProviderProfile" asp-action="CancelNameChange" asp-route-requestId="@waiting.RequestId" data-sv-once>
                        <button type="submit" class="sv-btn sv-btn--outline sv-btn--xs"
                                data-confirm="Cancel your request to change your name to @(waiting.NewName)?">Cancel Request</button>
                    </form>
                </div>
            }
            else if (nc.LastAnswer is { } answer)
            {
                <div class="sv-ncard__req">
                    <div class="sv-ncard__line">
                        <span>Last request: <strong>@answer.NewName</strong></span>
                        <span class="sv-tag sv-tag--@answer.Tone">@answer.Label</span>
                    </div>
                    <p class="sv-ncard__meta">@answer.WhenText</p>
                </div>
            }

            <button type="button" id="pf-nc-open" class="sv-btn sv-btn--primary sv-btn--sm" aria-haspopup="dialog" aria-controls="pf-nc-dialog"
                    aria-disabled="@(nc.CanRequest ? "false" : "true")" title="@(nc.CanRequest ? null : NameChangeRules.OnePending)">
                @Icons.Svg("user-pen", 14) Request Name Change
            </button>
            @if (!nc.CanRequest)
            {
                <p class="sv-ncard__wait">One request at a time: wait for the answer, or cancel the request above.</p>
            }

            @* The pop-up opens ONLY for data-open="true" (a refused request comes back with it open). Razor would write
               data-open="" for a null value, so the value is always "true" or "false". *@
            <dialog id="pf-nc-dialog" class="sv-dialog sv-ncdlg" aria-labelledby="pf-nc-dtitle" data-open="@(nc.OpenDialog ? "true" : "false")">
                <form method="post" asp-controller="ProviderProfile" asp-action="RequestNameChange" class="sv-dialog__form" data-sv-once data-sv-nc-form
                      data-current-first="@nc.CurrentFirst" data-current-middle="@nc.CurrentMiddle" data-current-last="@nc.CurrentLast">
                    <h2 id="pf-nc-dtitle" class="sv-dialog__title">Request Name Change</h2>
                    <p class="sv-dialog__text">Type your name exactly as it should appear to customers. Now: <strong>@nc.CurrentName</strong></p>
                    <p class="sv-formerr" role="alert" data-sv-nc-error hidden="@(nc.FormError is null ? "hidden" : null)">@nc.FormError</p>

                    <div class="sv-fld">
                        <label for="pf-nc-first">First Name</label>
                        <input id="pf-nc-first" name="FirstName" type="text" value="@ncForm.FirstName" required maxlength="100" autocomplete="given-name"
                               aria-invalid="@(firstErr is null ? null : "true")" />
                        @if (firstErr is not null) { <p class="sv-fld__err" role="alert">@firstErr</p> }
                    </div>
                    <div class="sv-fld">
                        <label for="pf-nc-middle">Middle Name</label>
                        <input id="pf-nc-middle" name="MiddleName" type="text" value="@ncForm.MiddleName" required minlength="2" maxlength="100" autocomplete="additional-name"
                               aria-invalid="@(middleErr is null ? null : "true")" />
                        @if (middleErr is not null) { <p class="sv-fld__err" role="alert">@middleErr</p> }
                    </div>
                    <div class="sv-fld">
                        <label for="pf-nc-last">Last Name</label>
                        <input id="pf-nc-last" name="LastName" type="text" value="@ncForm.LastName" required maxlength="100" autocomplete="family-name"
                               aria-invalid="@(lastErr is null ? null : "true")" />
                        @if (lastErr is not null) { <p class="sv-fld__err" role="alert">@lastErr</p> }
                    </div>
                    <div class="sv-fld">
                        <label for="pf-nc-reason">Reason <span class="sv-fld__opt">(up to 255 characters)</span></label>
                        <textarea id="pf-nc-reason" name="Reason" rows="3" required maxlength="255"
                                  placeholder="For example: I got married and use my husband's last name."
                                  aria-invalid="@(reasonErr is null ? null : "true")">@ncForm.Reason</textarea>
                        @if (reasonErr is not null) { <p class="sv-fld__err" role="alert">@reasonErr</p> }
                    </div>

                    <div class="sv-dialog__buttons">
                        <button type="button" class="sv-btn sv-btn--outline sv-btn--sm" data-sv-close>Cancel</button>
                        <button type="submit" class="sv-btn sv-btn--primary sv-btn--sm">Send Request</button>
                    </div>
                </form>
            </dialog>
        </section>
    }

    <!-- Services offered -->
    <section class="sv-panel sv-pf__card" aria-labelledby="pf-svc-title">
        <h2 id="pf-svc-title" class="sv-pf__title">Services Offered</h2>
        @if (Model.ServiceNames.Count == 0)
        {
            <p class="sv-pf__empty">You have no active services yet. <a asp-controller="ProviderServices" asp-action="Index">Add a service</a> so customers can find and book you.</p>
        }
        else
        {
            <ul class="sv-pf__pills">
                @foreach (var name in Model.ServiceNames)
                {
                    <li class="sv-pf__pill">@name</li>
                }
            </ul>
        }
    </section>

    <!-- Reviews -->
    <section class="sv-panel sv-pf__card" aria-labelledby="pf-rev-title">
        <h2 id="pf-rev-title" class="sv-pf__title">Reviews</h2>
        @if (Model.Reviews.Count == 0)
        {
            <p class="sv-pf__empty">No reviews yet. Completed jobs can be reviewed by your customers.</p>
        }
        else
        {
            <ul class="sv-pf__reviews">
                @foreach (var rv in Model.Reviews)
                {
                    <li class="sv-pf__review">
                        <div class="sv-pf__rate">
                            <span class="sv-stars" role="img" aria-label="Rated @rv.Rating out of 5">
                                @for (var n = 1; n <= 5; n++)
                                {
                                    <span class="@(n <= rv.Rating ? "is-on" : "")">@Icons.Svg("star", 14, filled: true)</span>
                                }
                            </span>
                            <strong>@rv.Rating.ToString("0.0", inv)</strong>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(rv.Comment))
                        {
                            <p class="sv-pf__quote">@rv.Comment</p>
                        }
                        <div class="sv-pf__by">@rv.Author · @rv.Date.ToString("MMM d, yyyy", inv)</div>
                    </li>
                }
            </ul>
        }
    </section>
</div>

@section Scripts {
    <script src="~/js/provider-profile.js" asp-append-version="true"></script>
}
