@using System.Globalization
@using Servisyo.Web.ViewModels
@model ServicesPageViewModel
@{
    ViewData["Title"] = "My Services";
    Layout = "_PortalLayout";
    ViewData["Shell"] = Model.Shell;
    ViewData["ActiveNav"] = "services";

    var inv = CultureInfo.InvariantCulture;
    var form = Model.Form;
    var noCategories = Model.Categories.Count == 0;

    // the problem text for each box (null = no problem)
    var nameError = Model.ErrorFor("ServiceName");
    var catError = Model.ErrorFor("CategoryId");
    var descError = Model.ErrorFor("Description");
    var priceError = Model.ErrorFor("Price");
    var durError = Model.ErrorFor("DurationMinutes");

    // the Edit dialog (open again only when the server rejected the changes)
    var edit = Model.EditForm;
    var editCard = Model.ShowEditDialog ? Model.Cards.FirstOrDefault(c => c.ServiceId == Model.EditServiceId) : null;
    var eNameError = Model.EditErrorFor("ServiceName");
    var eCatError = Model.EditErrorFor("CategoryId");
    var eDescError = Model.EditErrorFor("Description");
    var ePriceError = Model.EditErrorFor("Price");
}

<div class="sv-pagehead">
    <div>
        <p class="sv-eyebrow">Offerings</p>
        <h1 class="sv-dash__title">My Services</h1>
        <p class="sv-dash__sub">Manage the services you offer to customers.</p>
    </div>
    <button type="button" class="sv-btn sv-btn--primary sv-btn--sm" id="sv-svc-open"
            aria-haspopup="dialog" aria-controls="sv-svc-add">+ Add Service</button>
</div>

@if (!string.IsNullOrEmpty(Model.FlashMessage))
{
    <div class="sv-flash @(Model.FlashIsError ? "sv-flash--error" : "sv-flash--ok")" role="status">@Model.FlashMessage</div>
}

@if (Model.Cards.Count == 0)
{
    <div class="sv-panel sv-svc__empty">
        <p class="sv-panel__empty">You have not added any services yet. Use <strong>+ Add Service</strong> to list what you offer, so customers can find and book you.</p>
    </div>
}
else
{
    <ul class="sv-svc__list">
        @foreach (var c in Model.Cards)
        {
            <li class="sv-svc @(c.IsActive ? "" : "is-off")">
                <div class="sv-svc__body">
                    <div class="sv-svc__top">
                        <h2 class="sv-svc__name">@c.Name</h2>
                        <span class="sv-tag sv-tag--@c.StatusTone">@c.StatusText</span>
                    </div>
                    @if (c.Description is not null)
                    {
                        <p class="sv-svc__desc">@c.Description</p>
                    }
                    <p class="sv-svc__meta"><strong class="sv-svc__price">@c.PriceText</strong> <span>· @c.MetaText</span></p>
                </div>

                <div class="sv-svc__actions">
                    @if (c.EditLocked)
                    {
                        @* aria-disabled (not disabled) so the tooltip can still be reached by mouse, keyboard and touch;
                           the server refuses the change anyway (ServiceEditRules) *@
                        <span class="sv-tip" data-tip="@ServiceEditRules.LockedMessage">
                            <button type="button" class="sv-act sv-act--view is-locked" aria-disabled="true" data-svc-locked
                                    aria-describedby="sv-svc-lock-@c.ServiceId">Edit Service</button>
                            <span class="sv-sr-only" id="sv-svc-lock-@c.ServiceId">@ServiceEditRules.LockedMessage</span>
                        </span>
                    }
                    else
                    {
                        <button type="button" class="sv-act sv-act--view" data-svc-edit
                                data-edit-url="@Url.Action("Edit", "ProviderServices", new { serviceId = c.ServiceId })"
                                data-name="@c.Name" data-category-id="@c.CategoryId" data-category-name="@c.CategoryName"
                                data-description="@c.Description" data-price="@c.Price.ToString("0.##", inv)"
                                aria-haspopup="dialog" aria-controls="sv-svc-edit" aria-label="Edit @c.Name">Edit Service</button>
                    }

                    <form method="post" asp-controller="ProviderServices" asp-action="SetStatus" asp-route-serviceId="@c.ServiceId"
                          class="sv-inline-form" data-sv-once>
                        <input type="hidden" name="Activate" value="@(c.IsActive ? "false" : "true")" />
                        <button type="submit" class="sv-act @(c.IsActive ? "sv-act--warn" : "sv-act--ok")"
                                aria-label="@(c.IsActive ? "Deactivate" : "Activate") @c.Name">@(c.IsActive ? "Deactivate" : "Activate")</button>
                    </form>
                </div>
            </li>
        }
    </ul>
}

<!-- Add New Service: opened by "+ Add Service" (provider-services.js). It opens again by itself when the server rejected the form. -->
<dialog id="sv-svc-add" class="sv-dialog" aria-labelledby="sv-svc-add-title" data-open="@(Model.ShowAddDialog ? "true" : null)">
    <form method="post" asp-controller="ProviderServices" asp-action="Create" class="sv-dialog__form sv-svcform">
        <div class="sv-svcform__head">
            <h2 id="sv-svc-add-title" class="sv-dialog__title">Add New Service</h2>
            <button type="button" class="sv-svcform__x" data-sv-close aria-label="Close">&times;</button>
        </div>

        @if (!string.IsNullOrEmpty(Model.FormError))
        {
            <p class="sv-formerr" role="alert">@Model.FormError</p>
        }
        @if (noCategories)
        {
            <p class="sv-formerr" role="alert">No service categories are available yet. Please ask an administrator to add one.</p>
        }

        <div class="sv-fld">
            <label for="sv-svc-name">Service Name <span aria-hidden="true">*</span></label>
            <input id="sv-svc-name" name="ServiceName" type="text" value="@form.ServiceName" required maxlength="100"
                   placeholder="e.g. Pipe Repair" autofocus
                   aria-invalid="@(nameError is null ? null : "true")" />
            @if (nameError is not null) { <p class="sv-fld__err" role="alert">@nameError</p> }
        </div>

        <div class="sv-fld">
            <label for="sv-svc-cat">Category <span aria-hidden="true">*</span></label>
            <select id="sv-svc-cat" name="CategoryId" required disabled="@(noCategories ? "disabled" : null)"
                    aria-invalid="@(catError is null ? null : "true")">
                <option value="">Choose a category</option>
                @foreach (var cat in Model.Categories)
                {
                    <option value="@cat.CategoryId" selected="@(form.CategoryId == cat.CategoryId ? "selected" : null)">@cat.Name</option>
                }
            </select>
            @if (catError is not null) { <p class="sv-fld__err" role="alert">@catError</p> }
        </div>

        <div class="sv-fld">
            <label for="sv-svc-desc">Description <span class="sv-fld__opt">(optional)</span></label>
            <textarea id="sv-svc-desc" name="Description" rows="3" maxlength="255"
                      placeholder="What does this service include?"
                      aria-invalid="@(descError is null ? null : "true")">@form.Description</textarea>
            @if (descError is not null) { <p class="sv-fld__err" role="alert">@descError</p> }
        </div>

        <div class="sv-svcform__row">
            <div class="sv-fld">
                <label for="sv-svc-price">Price (₱, informational) <span aria-hidden="true">*</span></label>
                <input id="sv-svc-price" name="Price" type="number" inputmode="decimal" min="0" max="99999999.99" step="0.01" required
                       value="@(form.Price?.ToString("0.##", inv))" placeholder="e.g. 800"
                       aria-invalid="@(priceError is null ? null : "true")" />
                @if (priceError is not null) { <p class="sv-fld__err" role="alert">@priceError</p> }
            </div>
            <div class="sv-fld">
                <label for="sv-svc-dur">Usual duration <span aria-hidden="true">*</span></label>
                <select id="sv-svc-dur" name="DurationMinutes" required data-default="60"
                        aria-invalid="@(durError is null ? null : "true")">
                    @foreach (var d in Model.DurationOptions)
                    {
                        <option value="@d.Minutes" selected="@(form.DurationMinutes == d.Minutes ? "selected" : null)">@d.Label</option>
                    }
                </select>
                @if (durError is not null) { <p class="sv-fld__err" role="alert">@durError</p> }
            </div>
        </div>

        <div class="sv-dialog__buttons">
            <button type="button" class="sv-btn sv-btn--outline sv-btn--sm" data-sv-close>Cancel</button>
            <button type="submit" class="sv-btn sv-btn--primary sv-btn--sm" disabled="@(noCategories ? "disabled" : null)">Add Service</button>
        </div>
    </form>
</dialog>

<!-- Edit Service: opened by a card's "Edit Service" button (provider-services.js fills in that service's values).
     It opens again by itself when the server rejected the changes. The duration is not edited here. -->
<dialog id="sv-svc-edit" class="sv-dialog" aria-labelledby="sv-svc-edit-title" data-open="@(editCard is not null ? "true" : null)">
    @* the address (which service) is set by provider-services.js when the dialog opens; asp-antiforgery adds the token *@
    <form method="post" action="@(editCard is not null ? Url.Action("Edit", "ProviderServices", new { serviceId = editCard.ServiceId }) : null)"
          asp-antiforgery="true" class="sv-dialog__form sv-svcform" data-edit-form>
        <div class="sv-svcform__head">
            <h2 id="sv-svc-edit-title" class="sv-dialog__title">Edit Service</h2>
            <button type="button" class="sv-svcform__x" data-sv-close aria-label="Close">&times;</button>
        </div>
        <p class="sv-svcform__note">Customers with finished bookings keep the price they booked at.</p>

        @if (!string.IsNullOrEmpty(Model.EditFormError))
        {
            <p class="sv-formerr" role="alert">@Model.EditFormError</p>
        }

        <div class="sv-fld">
            <label for="sv-edit-name">Service Title <span aria-hidden="true">*</span></label>
            <input id="sv-edit-name" name="ServiceName" type="text" value="@edit.ServiceName" required maxlength="100"
                   aria-invalid="@(eNameError is null ? null : "true")" />
            @if (eNameError is not null) { <p class="sv-fld__err" role="alert">@eNameError</p> }
        </div>

        <div class="sv-fld">
            <label for="sv-edit-cat">Category <span aria-hidden="true">*</span></label>
            <select id="sv-edit-cat" name="CategoryId" required aria-invalid="@(eCatError is null ? null : "true")">
                <option value="">Choose a category</option>
                @foreach (var cat in Model.Categories)
                {
                    <option value="@cat.CategoryId" selected="@(edit.CategoryId == cat.CategoryId ? "selected" : null)">@cat.Name</option>
                }
                @if (editCard is not null && !Model.Categories.Any(x => x.CategoryId == editCard.CategoryId))
                {
                    @* the service's current category was deactivated by an administrator: it may be kept *@
                    <option value="@editCard.CategoryId" selected="@(edit.CategoryId == editCard.CategoryId ? "selected" : null)" data-current>@editCard.CategoryName</option>
                }
            </select>
            @if (eCatError is not null) { <p class="sv-fld__err" role="alert">@eCatError</p> }
        </div>

        <div class="sv-fld">
            <label for="sv-edit-desc">Description <span class="sv-fld__opt">(optional)</span></label>
            <textarea id="sv-edit-desc" name="Description" rows="3" maxlength="255"
                      aria-invalid="@(eDescError is null ? null : "true")">@edit.Description</textarea>
            @if (eDescError is not null) { <p class="sv-fld__err" role="alert">@eDescError</p> }
        </div>

        <div class="sv-fld">
            <label for="sv-edit-price">Price (₱) <span aria-hidden="true">*</span></label>
            <input id="sv-edit-price" name="Price" type="number" inputmode="decimal" min="0" max="99999999.99" step="0.01" required
                   value="@(edit.Price?.ToString("0.##", inv))" aria-invalid="@(ePriceError is null ? null : "true")" />
            @if (ePriceError is not null) { <p class="sv-fld__err" role="alert">@ePriceError</p> }
        </div>

        <div class="sv-dialog__buttons">
            <button type="button" class="sv-btn sv-btn--outline sv-btn--sm" data-sv-close>Cancel</button>
            <button type="submit" class="sv-btn sv-btn--primary sv-btn--sm">Save Changes</button>
        </div>
    </form>
</dialog>

@section Scripts {
    <script src="~/js/provider-services.js" asp-append-version="true"></script>
}
