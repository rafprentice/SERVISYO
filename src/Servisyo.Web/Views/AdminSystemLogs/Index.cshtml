@using System.Globalization
@using Servisyo.Web.Models
@using Servisyo.Web.ViewModels
@model SystemLogsPageViewModel
@{
    ViewData["Title"] = "System Logs";
    Layout = "_PortalLayout";
    ViewData["Shell"] = Model.Shell;
    ViewData["ActiveNav"] = "logs";

    var q = Model.Query;
    var logs = Model.Logs;
    var inv = CultureInfo.InvariantCulture;
    var fromText = q.From?.ToString("yyyy-MM-dd", inv);
    var toText = q.To?.ToString("yyyy-MM-dd", inv);
    var shownLabel = q.ActionType is null ? "" : " " + q.ActionType;     // "", " UPDATE", ...
    var emptyText = Model.AnyFilter || q.ActionType is not null
        ? $"No{shownLabel} log entries match these filters."
        : "No log entries yet. Changes to accounts, bookings, payments, services and reviews will appear here.";
    var firstRow = (logs.Page - 1) * logs.PageSize + 1;
    var lastRow = firstRow + logs.Items.Count - 1;
    var footText = logs.TotalCount == 0
        ? "No entries"
        : $"Showing {firstRow}–{lastRow} of {logs.TotalCount.ToString("N0", inv)}{shownLabel} {(logs.TotalCount == 1 ? "entry" : "entries")}";
}

<p class="sv-eyebrow">Audit</p>
<h1 class="sv-dash__title">System Logs</h1>
<p class="sv-dash__sub">Every change the database records (created, updated with the old and new value, deleted) and every sign-in.</p>

@* One pill per action type; the number is how many lines it has with the filters below. Every link keeps the filters. *@
<nav class="sv-tabs sv-tabs--inline sv-logs__tabs" aria-label="Filter by action">
    @foreach (var t in Model.Tabs)
    {
        var active = t.ActionType == q.ActionType;
        <a class="sv-tab @(active ? "is-active" : "")"
           href="@Url.Action("Index", "AdminSystemLogs", Model.Link(t.ActionType, 1))"
           aria-current="@(active ? "page" : null)">
            @t.Label <span class="sv-tab__n">(@(t.Count.ToString("N0", inv)))</span>
        </a>
    }
</nav>

<form method="get" asp-controller="AdminSystemLogs" asp-action="Index" class="sv-panel sv-logs__filters" role="search" aria-label="Filter the logs">
    @if (q.ActionType is not null)
    {
        <input type="hidden" name="actionType" value="@q.ActionType" />
    }
    <div class="sv-fld">
        <label for="lg-search">Search</label>
        <input id="lg-search" type="search" name="search" value="@q.Search" maxlength="100" placeholder="Booking #6, phone, email, service…" />
    </div>
    <div class="sv-fld">
        <label for="lg-from">From</label>
        <input id="lg-from" type="date" name="from" value="@fromText" />
    </div>
    <div class="sv-fld">
        <label for="lg-to">To</label>
        <input id="lg-to" type="date" name="to" value="@toText" />
    </div>
    <div class="sv-fld">
        <label for="lg-role">Role</label>
        <select id="lg-role" name="role">
            <option value="">All roles</option>
            @foreach (var r in SystemLogsPageViewModel.Roles)
            {
                <option value="@r" selected="@(r == q.Role)">@r</option>
            }
        </select>
    </div>
    <div class="sv-logs__btns">
        <button type="submit" class="sv-btn sv-btn--primary sv-btn--sm">Apply</button>
        @if (Model.AnyFilter)
        {
            @* clears the filters, stays on the same pill *@
            <a class="sv-btn sv-btn--outline sv-btn--sm" href="@Url.Action("Index", "AdminSystemLogs", new { actionType = q.ActionType })">Reset</a>
        }
    </div>
</form>

<div class="sv-table-wrap">
    <table class="sv-table sv-logs__table">
        <thead>
            <tr>
                <th scope="col">Log ID</th>
                <th scope="col">Timestamp</th>
                <th scope="col">User / Role</th>
                <th scope="col">Entity</th>
                <th scope="col">Action</th>
                <th scope="col">Description</th>
            </tr>
        </thead>
        <tbody>
            @if (logs.Items.Count == 0)
            {
                <tr><td colspan="6" class="sv-table__empty">@emptyText</td></tr>
            }
            @foreach (var r in logs.Items)
            {
                <tr>
                    <td class="sv-table__muted">#@r.Id</td>
                    <td class="sv-table__small sv-logs__time">@r.TimeText</td>
                    <td>
                        <div>@r.UserText</div>
                        <div class="sv-table__muted sv-table__small">@r.Role</div>
                    </td>
                    <td class="sv-table__small">@r.EntityText</td>
                    <td><span class="sv-tag sv-tag--@r.ActionTone">@r.Action</span></td>
                    <td class="sv-logs__desc">@r.Description</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="sv-table__foot">
    <span>@footText · times in Cebu time</span>
    @if (logs.PageCount > 1)
    {
        <nav class="sv-pager" aria-label="Pages">
            @if (logs.HasPrevious)
            {
                <a class="sv-btn sv-btn--outline sv-btn--xs" href="@Url.Action("Index", "AdminSystemLogs", Model.Link(q.ActionType, logs.Page - 1))">Previous</a>
            }
            <span>Page @logs.Page of @logs.PageCount</span>
            @if (logs.HasNext)
            {
                <a class="sv-btn sv-btn--outline sv-btn--xs" href="@Url.Action("Index", "AdminSystemLogs", Model.Link(q.ActionType, logs.Page + 1))">Next</a>
            }
        </nav>
    }
</div>
