@model Servisyo.Web.ViewModels.RegisterProviderViewModel
@{ ViewData["Title"] = "Join as a provider"; }

<div class="row justify-content-center">
    <div class="col-lg-8">
        <h1 class="h3 mb-3">Join as a service provider</h1>
        <p class="text-muted">Your application stays Pending until an administrator approves it.</p>
        <form asp-action="RegisterProvider" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <partial name="_UserFields" model="Model" />
            <hr />
            <div class="mb-3">
                <label asp-for="BusinessName" class="form-label"></label>
                <input asp-for="BusinessName" class="form-control" />
                <span asp-validation-for="BusinessName" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            <div class="row">
                <div class="col-md-8 mb-3">
                    <label asp-for="Address" class="form-label"></label>
                    <input asp-for="Address" class="form-control" />
                    <span asp-validation-for="Address" class="text-danger"></span>
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="City" class="form-label"></label>
                    <input asp-for="City" class="form-control" />
                    <span asp-validation-for="City" class="text-danger"></span>
                </div>
            </div>
            <div class="row">
                <div class="col-md-4 mb-3">
                    <label asp-for="BaseFee" class="form-label"></label>
                    <input asp-for="BaseFee" class="form-control" type="number" min="0" max="1000000" step="0.01" inputmode="decimal" data-sv-number />
                    <span asp-validation-for="BaseFee" class="text-danger"></span>
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="MinNoticeDays" class="form-label"></label>
                    <input asp-for="MinNoticeDays" class="form-control" type="number" min="0" max="30" step="1" inputmode="numeric" data-sv-number data-sv-whole />
                    <span asp-validation-for="MinNoticeDays" class="text-danger"></span>
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="MaxJobsPerDay" class="form-label"></label>
                    <input asp-for="MaxJobsPerDay" class="form-control" type="number" min="1" max="50" step="1" inputmode="numeric" data-sv-number data-sv-whole />
                    <span asp-validation-for="MaxJobsPerDay" class="text-danger"></span>
                </div>
            </div>
            <button type="submit" class="btn btn-primary">Submit application</button>
        </form>
        <p class="mt-3">Already registered? <a asp-action="Login">Sign in</a></p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Number boxes: browsers accept "1e5", "+" and "-" in type=number; block those keys and anything pasted that is not a plain number.
        (function () {
            document.querySelectorAll("[data-sv-number]").forEach(function (box) {
                var whole = box.hasAttribute("data-sv-whole");
                box.addEventListener("keydown", function (e) {
                    if (["e", "E", "+", "-"].indexOf(e.key) >= 0 || (whole && (e.key === "." || e.key === ","))) e.preventDefault();
                });
                box.addEventListener("paste", function (e) {
                    var text = (e.clipboardData || window.clipboardData).getData("text");
                    if (!(whole ? /^\d+$/ : /^\d+(\.\d{1,2})?$/).test(text.trim())) e.preventDefault();
                });
            });
        })();
    </script>
}
