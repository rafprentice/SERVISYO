@model Servisyo.Web.ViewModels.RegisterProviderViewModel
@{ ViewData["Title"] = "Join as a provider"; }

<div class="row justify-content-center">
    <div class="col-lg-8">
        <h1 class="h3 mb-3">Join as a service provider</h1>
        <p class="text-muted">Your application stays Pending until an administrator approves it.</p>
        <form asp-action="RegisterProvider" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <partial name="_UserFields" model="Model" />
            <hr />
            <div class="mb-3">
                <label asp-for="BusinessName" class="form-label"></label>
                <input asp-for="BusinessName" class="form-control" />
                <span asp-validation-for="BusinessName" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            <div class="row">
                <div class="col-12 mb-3">
                    <label asp-for="Address" class="form-label"></label>
                    <div class="input-group">
                        <span class="input-group-text" aria-hidden="true"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/><circle cx="12" cy="10" r="3"/></svg></span>
                        @* the full text is sent; the server splits it into street / barangay / city (see CebuLocations) *@
                        <select asp-for="Address" class="form-select" autocomplete="street-address">
                            <option value="">Choose your business address</option>
                            @foreach (var loc in Servisyo.Web.ViewModels.CebuLocations.All)
                            {
                                <option value="@loc.Full">@loc.Full</option>
                            }
                        </select>
                    </div>
                    <span asp-validation-for="Address" class="text-danger"></span>
                    <div class="form-text">SERVISYO is available in Cebu City only.</div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-4 mb-3">
                    <label asp-for="BaseFee" class="form-label"></label>
                    <input asp-for="BaseFee" class="form-control" type="number" min="1" max="100000" step="any" inputmode="decimal" placeholder="e.g. 500"
                           data-sv-number data-sv-basefee aria-describedby="BaseFee-error"
                           data-msg-required="@Servisyo.Web.ViewModels.BaseFeeRules.RequiredMessage" data-msg-min="@Servisyo.Web.ViewModels.BaseFeeRules.MinMessage"
                           data-msg-max="@Servisyo.Web.ViewModels.BaseFeeRules.MaxMessage" data-msg-nan="@Servisyo.Web.ViewModels.BaseFeeRules.NotANumberMessage" />
                    <span asp-validation-for="BaseFee" id="BaseFee-error" class="text-danger" data-sv-basefee-msg></span>
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="MinNoticeDays" class="form-label"></label>
                    <input asp-for="MinNoticeDays" class="form-control" type="number" min="0" max="30" step="1" inputmode="numeric" data-sv-number data-sv-whole />
                    <span asp-validation-for="MinNoticeDays" class="text-danger"></span>
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="MaxJobsPerDay" class="form-label"></label>
                    <input asp-for="MaxJobsPerDay" class="form-control" type="number" min="1" max="@Servisyo.Web.Models.ProviderLimits.MaxJobsPerDay" step="1" inputmode="numeric" data-sv-number data-sv-whole />
                    <span asp-validation-for="MaxJobsPerDay" class="text-danger"></span>
                </div>
            </div>
            <button type="submit" class="btn btn-primary">Submit application</button>
        </form>
        <p class="mt-3">Already registered? <a asp-action="Login">Sign in</a></p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/base-fee.js" asp-append-version="true"></script>
    <script src="~/js/min-length.js" asp-append-version="true"></script>
    <script>
        // Number boxes: browsers accept "1e5", "+" and "-" in type=number; block those keys and anything pasted that is not a plain number.
        (function () {
            document.querySelectorAll("[data-sv-number]").forEach(function (box) {
                var whole = box.hasAttribute("data-sv-whole");
                box.addEventListener("keydown", function (e) {
                    if (["e", "E", "+", "-"].indexOf(e.key) >= 0 || (whole && (e.key === "." || e.key === ","))) e.preventDefault();
                });
                box.addEventListener("paste", function (e) {
                    var text = (e.clipboardData || window.clipboardData).getData("text");
                    if (!(whole ? /^\d+$/ : /^\d+(\.\d{1,2})?$/).test(text.trim())) e.preventDefault();
                });
            });
        })();
    </script>
}
