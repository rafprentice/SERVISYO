@model Servisyo.Web.ViewModels.ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset password";
    Layout = "_AuthLayout";
    var info = TempData["ResetInfo"] as string;
    var emailLocked = !string.IsNullOrWhiteSpace(Model.Email);
    var emailBoxClass = emailLocked ? "sv-input sv-readonly" : "sv-input";
}

<partial name="_OtpStyles" />

<div class="sv-auth">
    <h1 class="sv-auth__title">Enter your reset code</h1>
    <p class="sv-auth__sub">Type the 6-digit code from your email and choose a new password.</p>

    <div class="sv-auth__card">
        @if (!string.IsNullOrEmpty(info))
        {
            <div class="sv-notice sv-notice--info" role="status">@info</div>
        }

        <form asp-action="ResetPassword" method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="sv-alert" role="alert"></div>

            <div class="sv-field">
                <label asp-for="Email" class="sv-label"></label>
                <div class="@emailBoxClass">
                    <span class="sv-input__icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg></span>
                    @if (emailLocked)
                    {
                        <input asp-for="Email" type="email" readonly autocomplete="email" />
                    }
                    else
                    {
                        <input asp-for="Email" type="email" placeholder="you@gmail.com" autocomplete="email" autofocus />
                    }
                </div>
                <span asp-validation-for="Email" class="sv-error"></span>
            </div>

            <div class="sv-field">
                <label asp-for="Code" class="sv-label"></label>
                <div class="sv-input sv-code">
                    <input asp-for="Code" type="text" inputmode="numeric" pattern="[0-9]*" maxlength="6" placeholder="000000" autocomplete="one-time-code" autofocus="@emailLocked" />
                </div>
                <span asp-validation-for="Code" class="sv-error"></span>
            </div>

            <div class="sv-field">
                <label asp-for="NewPassword" class="sv-label"></label>
                <div class="sv-input">
                    <span class="sv-input__icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="11" x="3" y="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg></span>
                    <input asp-for="NewPassword" placeholder="Min. 8 characters" autocomplete="new-password" />
                    <partial name="_PasswordToggle" model="@("NewPassword")" />
                </div>
                <span asp-validation-for="NewPassword" class="sv-error"></span>
            </div>

            <div class="sv-field">
                <label asp-for="ConfirmPassword" class="sv-label"></label>
                <div class="sv-input">
                    <span class="sv-input__icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="11" x="3" y="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg></span>
                    <input asp-for="ConfirmPassword" placeholder="Re-enter new password" autocomplete="new-password" />
                    <partial name="_PasswordToggle" model="@("ConfirmPassword")" />
                </div>
                <span asp-validation-for="ConfirmPassword" class="sv-error"></span>
            </div>

            <button type="submit" class="sv-btn sv-btn--primary sv-btn--block sv-btn--lg">Reset Password</button>
        </form>

        @if (emailLocked)
        {
            <div class="sv-resend">
                Didn't get the code?
                <form asp-action="ResendResetCode" method="post">
                    <input type="hidden" name="email" value="@Model.Email" />
                    <button type="submit" class="sv-linkbtn" id="resendBtn" data-cooldown="60">Resend code</button>
                </form>
                &middot; <a asp-action="ForgotPassword" class="sv-linkbtn">Use a different email</a>
            </div>
        }
    </div>

    <a class="sv-auth__back" asp-action="Login"><span aria-hidden="true">‹</span> Back to sign in</a>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Keep only digits in the code box, and make "Resend code" wait one minute (the server enforces the same rule).
        (function () {
            var code = document.getElementById('Code');
            if (code) code.addEventListener('input', function () { code.value = code.value.replace(/\D/g, '').slice(0, 6); });

            var btn = document.getElementById('resendBtn');
            if (!btn) return;
            var left = parseInt(btn.getAttribute('data-cooldown'), 10) || 60;
            btn.disabled = true;
            var timer = setInterval(function () {
                left--;
                if (left <= 0) { clearInterval(timer); btn.disabled = false; btn.textContent = 'Resend code'; }
                else { btn.textContent = 'Resend code in ' + left + 's'; }
            }, 1000);
            btn.textContent = 'Resend code in ' + left + 's';
        })();
    </script>
}
