@model Servisyo.Web.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Sign In";
    Layout = "_AuthLayout";
}

@section HeaderRight {
    <span class="sv-muted">New to SERVISYO?</span>
    <a asp-action="Register">Create an account →</a>
}

<div class="sv-auth">
    <div class="sv-auth__badge" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0z"/></svg>
    </div>
    <h1 class="sv-auth__title">Sign In to SERVISYO</h1>
    <p class="sv-auth__sub">Access your Customer, Provider, or Admin portal</p>

    <div class="sv-auth__card">
        <form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="sv-alert" role="alert"></div>

            <div class="sv-field">
                <label asp-for="Email" class="sv-label"></label>
                <div class="sv-input">
                    <span class="sv-input__icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg></span>
                    <input asp-for="Email" placeholder="your@email.com" autocomplete="email" autofocus />
                </div>
                <span asp-validation-for="Email" class="sv-error"></span>
            </div>

            <div class="sv-field">
                <div class="sv-field__row">
                    <label asp-for="Password" class="sv-label"></label>
                    <a asp-action="ForgotPassword" class="sv-link-sm">Forgot password?</a>
                </div>
                <div class="sv-input">
                    <span class="sv-input__icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="11" x="3" y="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg></span>
                    <input asp-for="Password" placeholder="••••••••••••" autocomplete="current-password" />
                    <partial name="_PasswordToggle" model="@("Password")" />
                </div>
                <span asp-validation-for="Password" class="sv-error"></span>
            </div>

            <label class="sv-check">
                <input asp-for="RememberMe" type="checkbox" />
                <span>Remember me for 30 days</span>
            </label>

            <button type="submit" class="sv-btn sv-btn--primary sv-btn--block sv-btn--lg">Sign In <span aria-hidden="true">→</span></button>

            <div class="sv-divider"><span>Don't have an account?</span></div>

            <a class="sv-btn sv-btn--outline sv-btn--block sv-btn--lg" asp-action="Register">Create a free account</a>
        </form>
    </div>

    <a class="sv-auth__back" asp-controller="Home" asp-action="Index"><span aria-hidden="true">‹</span> Back to homepage</a>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
