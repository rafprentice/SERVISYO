@model Servisyo.Web.ViewModels.CustomerRegistrationViewModel
@{
    ViewData["Title"] = "Create your account";
    Layout = "_AuthLayout";
}

<div class="sv-auth sv-auth--register">
    <div class="sv-auth__card sv-auth__card--flush">
        <div class="sv-banner">
            <div class="sv-banner__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><line x1="19" x2="19" y1="8" y2="14"/><line x1="22" x2="16" y1="11" y2="11"/></svg>
            </div>
            <div>
                <p class="sv-banner__eyebrow">Customer Registration</p>
                <h1 class="sv-banner__title">Create your account</h1>
            </div>
            <p class="sv-banner__text">Join SERVISYO and start booking trusted local service providers.</p>
        </div>

        <form asp-action="Register" method="post" class="sv-auth__form" novalidate>
            <div asp-validation-summary="ModelOnly" class="sv-alert" role="alert"></div>

            <div class="sv-field">
                <label asp-for="FullName" class="sv-label">Full Name <span class="sv-req">*</span></label>
                <div class="sv-input">
                    <span class="sv-input__icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0z"/></svg></span>
                    <input asp-for="FullName" placeholder="Juan dela Cruz" autocomplete="name" autofocus />
                </div>
                <span asp-validation-for="FullName" class="sv-error"></span>
            </div>

            <div class="sv-field">
                <label asp-for="Email" class="sv-label">Email Address <span class="sv-req">*</span></label>
                <div class="sv-input">
                    <span class="sv-input__icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg></span>
                    <input asp-for="Email" placeholder="you@email.com" autocomplete="email" />
                </div>
                <span asp-validation-for="Email" class="sv-error"></span>
            </div>

            <div class="sv-field">
                <label asp-for="PhoneNumber" class="sv-label">Phone Number <span class="sv-req">*</span></label>
                <div class="sv-input">
                    <span class="sv-input__icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg></span>
                    <input asp-for="PhoneNumber" type="tel" placeholder="09XX-XXX-XXXX" autocomplete="tel" inputmode="tel"
                           pattern="\+?[0-9\s\-]{7,15}" maxlength="16" title="Digits, spaces and hyphens only, e.g. 0917-555-1234" />
                </div>
                <span asp-validation-for="PhoneNumber" class="sv-error"></span>
            </div>

            <div class="sv-field">
                <label asp-for="StreetAddress" class="sv-label">Street Address <span class="sv-req">*</span></label>
                <div class="sv-input">
                    <span class="sv-input__icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/><circle cx="12" cy="10" r="3"/></svg></span>
                    <input asp-for="StreetAddress" placeholder="123 Rizal St." autocomplete="street-address" />
                </div>
                <span asp-validation-for="StreetAddress" class="sv-error"></span>
            </div>

            <div class="sv-two">
                <div class="sv-field">
                    <label asp-for="Barangay" class="sv-label">Barangay <span class="sv-req">*</span></label>
                    <div class="sv-input sv-input--plain">
                        <input asp-for="Barangay" placeholder="Brgy. San Isidro" />
                    </div>
                    <span asp-validation-for="Barangay" class="sv-error"></span>
                </div>
                <div class="sv-field">
                    <label asp-for="City" class="sv-label">City <span class="sv-muted">(optional)</span></label>
                    <div class="sv-input sv-input--plain">
                        <input asp-for="City" placeholder="Cebu City" autocomplete="address-level2" />
                    </div>
                    <span asp-validation-for="City" class="sv-error"></span>
                </div>
            </div>

            <div class="sv-field">
                <label asp-for="Password" class="sv-label">Password <span class="sv-req">*</span></label>
                <div class="sv-input">
                    <span class="sv-input__icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="11" x="3" y="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg></span>
                    <input asp-for="Password" placeholder="Min. 8 characters" autocomplete="new-password" />
                    <partial name="_PasswordToggle" model="@("Password")" />
                </div>
                <span asp-validation-for="Password" class="sv-error"></span>
            </div>

            <div class="sv-field">
                <label asp-for="ConfirmPassword" class="sv-label">Confirm Password <span class="sv-req">*</span></label>
                <div class="sv-input">
                    <span class="sv-input__icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="11" x="3" y="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg></span>
                    <input asp-for="ConfirmPassword" placeholder="Re-enter password" autocomplete="new-password" />
                </div>
                <span asp-validation-for="ConfirmPassword" class="sv-error"></span>
            </div>

            <div class="sv-field">
                <label class="sv-check sv-check--terms">
                    <input asp-for="AcceptTerms" type="checkbox" />
                    <span>I agree to the <a asp-controller="Home" asp-action="Terms" target="_blank" rel="noopener">Terms of Service</a> and <a asp-controller="Home" asp-action="Privacy" target="_blank" rel="noopener">Privacy Policy</a></span>
                </label>
                <span asp-validation-for="AcceptTerms" class="sv-error"></span>
            </div>

            <button type="submit" class="sv-btn sv-btn--primary sv-btn--block sv-btn--lg">Create Account</button>

            <p class="sv-auth__switch">Already have an account? <a asp-action="Login">Sign in</a></p>
        </form>
    </div>

    <p class="sv-auth__portals">
        Other portals:
        <a asp-action="RegisterProvider">Provider</a>
        <span aria-hidden="true">·</span>
        <a asp-action="Login">Admin</a>
    </p>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
