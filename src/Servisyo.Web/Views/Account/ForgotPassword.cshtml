@model Servisyo.Web.ViewModels.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot password";
    Layout = "_AuthLayout";
}

<partial name="_OtpStyles" />

<div class="sv-auth">
    <h1 class="sv-auth__title">Forgot your password?</h1>
    <p class="sv-auth__sub">Enter your registered email address and we will send you a password reset code.</p>

    <div class="sv-auth__card">
        <form asp-action="ForgotPassword" method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="sv-alert" role="alert"></div>

            <div class="sv-field">
                <label asp-for="Email" class="sv-label"></label>
                <div class="sv-input">
                    <span class="sv-input__icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg></span>
                    <input asp-for="Email" type="email" placeholder="you@gmail.com" autocomplete="email" autofocus />
                </div>
                <span asp-validation-for="Email" class="sv-error"></span>
            </div>

            <button type="submit" class="sv-btn sv-btn--primary sv-btn--block sv-btn--lg">Send Reset Code</button>
        </form>
    </div>

    <a class="sv-auth__back" asp-action="Login"><span aria-hidden="true">‹</span> Back to sign in</a>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
