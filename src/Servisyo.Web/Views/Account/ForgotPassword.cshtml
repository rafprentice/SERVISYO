@{
    ViewData["Title"] = "Forgot password";
    Layout = "_AuthLayout";
}
<div class="sv-auth">
    <h1 class="sv-auth__title">Forgot your password?</h1>
    <p class="sv-auth__sub">Automatic password reset is not available yet.</p>
    <div class="sv-auth__card">
        <p class="sv-card__text">For now, please contact a SERVISYO administrator to have your password reset. Online reset will be added in a future update.</p>
        <a class="sv-btn sv-btn--primary sv-btn--block sv-btn--lg" asp-action="Login">Back to sign in</a>
    </div>
    <a class="sv-auth__back" asp-controller="Home" asp-action="Index"><span aria-hidden="true">‹</span> Back to homepage</a>
</div>
